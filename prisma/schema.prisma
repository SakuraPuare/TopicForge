// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 毕业设计题目表
model GraduationTopic {
  id          String   @id @default(cuid())
  title       String
  school      String?
  major       String?
  year        Int?
  keywords    String?  // JSON格式存储关键词数组
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联的分词结果
  tokenizedWords TokenizedWord[]

  // 组合唯一约束：相同的题目、学校、专业、年份才算重复
  @@unique([title, school, major, year])
  @@map("graduation_topics")
}

// 分词结果表
model TokenizedWord {
  id        String @id @default(cuid())
  topicId   String
  word      String
  position  Int
  frequency Int    @default(1)

  // 关联到题目
  topic     GraduationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("tokenized_words")
}

// 生成会话表 - 存储完整的生成结果
model GenerationSession {
  id         String   @id @default(cuid())
  topics     String   // 生成的题目数组 (JSON字符串)
  algorithm  String   // 使用的算法
  params     String   // 生成参数 (JSON字符串)
  stats      String   // 生成统计信息 (JSON字符串)
  createdAt  DateTime @default(now())
  expiresAt  DateTime // 过期时间，用于清理旧数据

  @@map("generation_sessions")
}

// 生成历史表
model GeneratedTopic {
  id        String   @id @default(cuid())
  content   String
  algorithm String   // 'markov', 'template', etc.
  params    Json?    // 生成参数
  rating    Int?     // 用户评分 1-5
  createdAt DateTime @default(now())

  @@map("generated_topics")
}

// 马尔科夫链状态表
model MarkovChain {
  id          String @id @default(cuid())
  currentWord String
  nextWord    String
  frequency   Int    @default(1)

  @@unique([currentWord, nextWord])
  @@map("markov_chains")
}

// 关键词统计表
model KeywordStats {
  id        String   @id @default(cuid())
  keyword   String   @unique
  frequency Int      @default(1)
  category  String?  // 专业类别
  updatedAt DateTime @updatedAt

  @@map("keyword_stats")
}

// 专业信息表
model Major {
  id              String   @id @default(cuid())
  name            String   @unique
  displayName     String?  // 显示名称
  category        String?  // 专业类别
  description     String?  // 专业描述
  sampleCount     Int      @default(0) // 样本数量
  hasModel        Boolean  @default(false) // 是否有训练模型
  lastTrainingAt  DateTime? // 最后训练时间
  qualityStats    Json?    // 质量统计信息
  keywords        Json?    // 专业关键词
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("majors")
}

// 专业特定的马尔科夫链表
model MajorMarkovChain {
  id          String @id @default(cuid())
  major       String
  currentWord String
  nextWord    String
  frequency   Int    @default(1)

  @@unique([major, currentWord, nextWord])
  @@map("major_markov_chains")
}

// 预计算模型表 - 存储各级模型的预计算数据
model PrecomputedModel {
  id              String   @id @default(cuid())

  // 模型标识
  scope           String   // 'major' | 'category' | 'general'
  name            String   // 专业名/类别名，general时为'_global'

  // 预计算词汇（JSON存储）
  startTokens     Json     // ["基于", "关于", ...] 开始词列表
  endTokens       Json     // ["系统", "研究", ...] 结束词列表
  highFreqWords   Json     // ["设计", "分析", ...] 高频词Top50

  // 模型统计
  sampleCount     Int      // 训练样本数
  stateCount      Int      // 马尔科夫状态数
  transitionCount Int      // 转移总数

  // 回退配置
  fallbackTo      String?  // 回退目标：类别名或'_global'
  isReady         Boolean  @default(false)  // 是否可用于生成

  // 质量信息
  avgQuality      Float?   // 平均质量分
  qualityDistribution Json? // {high: n, medium: n, low: n}

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scope, name])
  @@index([scope])
  @@index([isReady])
  @@map("precomputed_models")
}

// 专业类别映射表
model MajorCategory {
  id        String   @id @default(cuid())
  major     String   @unique  // 专业名称
  category  String            // 所属类别

  @@index([category])
  @@map("major_categories")
}

// 生成配置表
model GenerationConfig {
  id          String   @id @default(cuid())
  key         String   @unique  // 配置键
  value       Json              // 配置值
  description String?           // 配置说明
  updatedAt   DateTime @updatedAt

  @@map("generation_config")
}
